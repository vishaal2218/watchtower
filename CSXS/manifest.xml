<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="watchtower.replica" ExtensionBundleVersion="1.6.1"
    ExtensionBundleName="Watchtower" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="watchtower.replica.panel" Version="1.6.1"/>
    <Extension Id="watchtower.replica.manager" Version="1.6.1"/>
    <Extension Id="watchtower.replica.settings" Version="1.6.1"/>
    <Extension Id="watchtower.replica.engine" Version="1.6.1"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- Premiere Pro 2020 (14.0) and later, After Effects 2020 (17.0) and later -->
      <Host Name="PPRO" Version="[14.0,99.9]"/>
      <Host Name="AEFT" Version="[17.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>

    <!-- The visible control panel: Window > Extensions > Watchtower -->
    <Extension Id="watchtower.replica.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/panel/index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Watchtower</Menu>
          <Geometry>
            <Size><Height>160</Height><Width>300</Width></Size>
            <MinSize><Height>120</Height><Width>230</Width></MinSize>
            <MaxSize><Height>600</Height><Width>900</Width></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

    <!-- Watch-folders manager window -->
    <Extension Id="watchtower.replica.manager">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/manager/index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Modeless</Type>
          <Geometry>
            <Size><Height>560</Height><Width>980</Width></Size>
            <MinSize><Height>360</Height><Width>760</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

    <!-- Settings dialog -->
    <Extension Id="watchtower.replica.settings">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/settings/index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>ModalDialog</Type>
          <Geometry>
            <Size><Height>540</Height><Width>600</Width></Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

    <!-- Invisible background sync engine. Starts with the host application
         and keeps running when the panel is closed. -->
    <Extension Id="watchtower.replica.engine">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/engine/index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size><Height>1</Height><Width>1</Width></Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

  </DispatchInfoList>
</ExtensionManifest>
